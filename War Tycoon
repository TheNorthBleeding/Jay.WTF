local function GetTargetPart(plr)
    if State.SilentAimTargetPart == "Head" then return GetHead(plr) end
    if State.SilentAimTargetPart == "Root" then return GetRoot(plr) end
    return GetHead(plr)
end

local function HasLineOfSight(plr, part)
    if not State.SilentAimVisible then return true end
    local origin = Camera.CFrame.Position
    local dir = (part.Position - origin)
    local ray = Ray.new(origin, dir.Unit * dir.Magnitude)
    local hit = Workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character, Camera})
    return hit and hit:IsDescendantOf(plr.Character)
end

local function GetClosestToCrosshair(fovRadius)
    local closest, shortest = nil, fovRadius
    local center = Camera.ViewportSize / 2
    for _, plr in ipairs(TrackedPlayers) do
        if not IsAlive(plr) then continue end
        if not IsEnemy(plr) then continue end
        local head = GetHead(plr); if not head then continue end
        local sp, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then continue end
        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if d < shortest then shortest = d; closest = plr end
    end
    return closest
end

local silentHooked = false
local oldNC = nil
local function SetupSilentAim()
    if silentHooked then return end
    local FireGun = ReplicatedStorage:WaitForChild("BulletFireSystem", 10)
    FireGun = FireGun and FireGun:WaitForChild("FireGun", 10)
    if not FireGun then return end
    local mt = getrawmetatable(game)
    setreadonly(mt, false)
    oldNC = mt.__namecall
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if State.SilentAim and method == "FireServer" and self == FireGun then
            local args = {...}
            if typeof(args[1]) == "table" then
                if math.random(1, 100) <= State.SilentAimHitChance then
                    local target = GetClosestToCrosshair(State.SilentAimFOV)
                    if target then
                        local part = GetTargetPart(target)
                        if part and HasLineOfSight(target, part) then
                            local origin = Camera.CFrame.Position
                            local dir = (part.Position - origin).Unit
                            args[1] = {dir.X, dir.Y, dir.Z}
                        end
                    end
                end
            end
            return oldNC(self, table.unpack(args))
        end
        return oldNC(self, ...)
    end)
    setreadonly(mt, true)
    silentHooked = true
end

local fireBind = nil
local lastFire = 0
local function StartForceFire()
    if fireBind then fireBind:Disconnect() end
    fireBind = RunService.Heartbeat:Connect(function()
        if not State.SilentAimForceFire then return end
        if not State.SilentAim then return end
        local now = tick()
        if now - lastFire < 0.15 then return end
        local target = GetClosestToCrosshair(State.SilentAimFOV)
        if not target then return end
        local part = GetTargetPart(target)
        if not part then return end
        if not HasLineOfSight(target, part) then return end
        lastFire = now
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
            task.wait(0.03)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
        end)
    end)
end

local function AimbotStep()
    if not State.Aimbot then return end
    if State.AimbotKeybindEverUsed then
        if not State.AimbotKeybindActive then return end
    else
        if not UserInputService:IsMouseButtonPressed(State.AimbotKey) then return end
    end
    local target = GetClosestToCrosshair(State.AimbotFOV)
    if not target then return end
    local head = GetHead(target); if not head then return end
    local currentCF = Camera.CFrame
    local targetCF = CFrame.new(currentCF.Position, head.Position)
    Camera.CFrame = currentCF:Lerp(targetCF, State.AimbotSmooth)
end

RunService:BindToRenderStep("JayAimbotStep", Enum.RenderPriority.Camera.Value + 1, AimbotStep)

