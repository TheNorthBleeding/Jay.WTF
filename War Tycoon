local function HideViewmodel()
    HiddenParts = {}
    for _, obj in ipairs(Camera:GetChildren()) do
        if obj:IsA("Model") or obj:IsA("Part") then
            if obj:FindFirstChild("Right Arm") or obj:FindFirstChild("RightHand") or obj.Name:lower():find("arm") or obj.Name:lower():find("view") then
                HiddenParts[obj] = {}
                for _, part in ipairs(obj:GetDescendants()) do
                    if part:IsA("BasePart") then
                        HiddenParts[obj][part] = part.Transparency
                        part.Transparency = 1
                    end
                end
            end
        end
    end
end
local function RestoreViewmodel()
    for obj, parts in pairs(HiddenParts) do
        if obj and obj.Parent then
            for part, trans in pairs(parts) do
                if part and part.Parent then part.Transparency = trans end
            end
        end
    end
    HiddenParts = {}
end
