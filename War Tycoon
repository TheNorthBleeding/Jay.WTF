                                char.HumanoidRootPart.CFrame = rig.CFrame
                                task.wait(2)
                                local template = capture:FindFirstChild("Barrel Template")
                                if template and template.PromptPart then
                                    fireproximityprompt(template.PromptPart.BarrelPickup)
                                    task.wait(1)
                                end
                            else
                                char.HumanoidRootPart.CFrame = rig.CFrame
                            end
                        end
                    end
                else
                    for _, tycoon in pairs(workspace.Tycoon.Tycoons:GetChildren()) do
                        if LocalPlayer == tycoon.Owner.Value then
                            local coll = tycoon.Essentials["Oil Collector"]
                            if coll and coll.Collector then
