local function getNearestRebirthButton()
    local huge = math.huge
    local result = nil
    for _, tycoon in pairs(workspace.Tycoon.Tycoons:GetChildren()) do
        if tycoon.Owner.Value == LocalPlayer then
            for _, btn in pairs(tycoon.UnpurchasedButtons:GetChildren()) do
                if tostring(btn.Neon.Color) == "1, 1, 0" and tonumber(btn:GetAttribute("RebirthAmount")) <= LocalPlayer.leaderstats.Rebirths.Value then
                    local mag = (LocalPlayer.Character.HumanoidRootPart.Position - btn.Gradient.Position).magnitude
                    if mag < huge then huge = mag; result = btn end
                end
            end
        end
    end
    return result
end

task.spawn(function()
    while true do
        task.wait(0.1)
        if FarmCfg.OilBarrels then
            pcall(function()
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end
