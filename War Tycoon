local function RemoveESP(plr)
    local o = ESPObjects[plr]; if not o then return end
    pcall(function() if o.Box then o.Box:Destroy() end end)
    pcall(function() if o.Billboard then o.Billboard:Destroy() end end)
    ESPObjects[plr] = nil
    if ESPAvatars[plr] then
        pcall(function() ESPAvatars[plr]:Destroy() end)
        ESPAvatars[plr] = nil
    end
end

local function ClearESP()
    for p, _ in pairs(ESPObjects) do RemoveESP(p) end
    for p, _ in pairs(ESPAvatars) do
