local BasicAimbotCircle = nil
local BasicAimbotTracer = nil
local BasicAimbotConnections = {}
local BasicAimbotActive = false

local function FindClosestPlayer()
    local closest = math.huge
    local target = nil
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local head = plr.Character:FindFirstChild("Head")
            if head and plr.Team ~= LocalPlayer.Team then
                local sp, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d <= 250 and d < closest then
                        closest = d
                        target = head
                    end
                end
            end
        end
    end
    return target
end

local function ToggleBasicAimbot()
    State.BasicAimbot = not State.BasicAimbot
    if State.BasicAimbot then
        BasicAimbotCircle = Drawing.new("Circle")
        BasicAimbotCircle.Thickness = 5
        BasicAimbotCircle.NumSides = 64
        BasicAimbotCircle.Radius = 250
        BasicAimbotCircle.Filled = false
        BasicAimbotCircle.Transparency = 1
        BasicAimbotCircle.Color = Color3.new(1, 1, 1)
        BasicAimbotCircle.Visible = true
        BasicAimbotTracer = Drawing.new("Line")
        BasicAimbotTracer.Thickness = 2
        BasicAimbotTracer.Color = Color3.new(1, 1, 1)
        BasicAimbotTracer.Visible = false
        table.insert(BasicAimbotConnections, RunService.RenderStepped:Connect(function()
            BasicAimbotCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            if BasicAimbotActive then
                local target = FindClosestPlayer()
                if target then
                    local sp = Camera:WorldToViewportPoint(target.Position)
                    BasicAimbotTracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    BasicAimbotTracer.To = Vector2.new(sp.X, sp.Y)
                    BasicAimbotTracer.Visible = true
                else
                    BasicAimbotTracer.Visible = false
                end
            else
                BasicAimbotTracer.Visible = false
            end
        end))
        table.insert(BasicAimbotConnections, UserInputService.InputBegan:Connect(function(input, processed)
            if not processed and input.KeyCode == State.BasicAimbotKey then
                BasicAimbotActive = true
            end
        end))
        table.insert(BasicAimbotConnections, UserInputService.InputEnded:Connect(function(input)
            if input.KeyCode == State.BasicAimbotKey then
                BasicAimbotActive = false
                BasicAimbotTracer.Visible = false
            end
        end))
    else
        if BasicAimbotCircle then BasicAimbotCircle:Remove() end
        if BasicAimbotTracer then BasicAimbotTracer:Remove() end
        for _, c in ipairs(BasicAimbotConnections) do c:Disconnect() end
        BasicAimbotConnections = {}
        BasicAimbotCircle = nil
        BasicAimbotTracer = nil
    end
end

