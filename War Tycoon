                    for i = 1, 2 do
                        local rig = workspace.Beams:FindFirstChild("Oil Rig"..tostring(i))
                        if rig then
                            local capture = workspace["Game Systems"].Warehouses["Oil Rig"..tostring(i)]["Oil Capture"]
